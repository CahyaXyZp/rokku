* text=auto
* text eol=lf

# Windows forced line-endings
/.idea/* text eol=crlf

# Gradle wrapper
*.jar binary

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.swp binary

# Discord Social SDK - without this, git's own binary detection can miss the AAR and
# CRLF-normalize it on commit, corrupting the archive (this is why the earlier commit warned
# "CRLF will be replaced by LF" for discord_partner_sdk.aar).
*.aar binary
*.so binary
